@* @Model Products *@


    <h2 style="align-content: center">All Products List</h2>
    <table class="table table-bordered table-hover">table of all Products
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>price</th>
        <th>description</th>
        <th>image URL</th>
        <th>image</th>
        <th>show Details</th>
    </tr>
            @{
                foreach (Products item in Model)
                {
                    <tr>
                        <td>@item.id</td>
                        <td>@item.productName</td>
                        <td>@item.price</td>
                        <td>@item.description</td>
                        <td>@item.imageURL</td>
                        <td>
                            <img src="/Images/@item.imageURL" alt="@item.productName" style="width:100px" />
                        </td>
                        <td>
                            <a href="/products/productId/@item.id" class="btn btn-info btn-sm">Show Details</a>
                        </td>
                    </tr>
                }
            }
    </table>